NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Server only. Never prefix this with NEXT_PUBLIC_.
OPENAI_API_KEY=your-openai-api-key
OPENAI_TEXT_MODEL=gpt-5.6-luna
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Billing. All except NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY are server-only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
STRIPE_SECRET_KEY=sk_test_or_live
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_or_live
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_CORE_MONTHLY_PRICE_ID=price_core_monthly
STRIPE_PREMIUM_MONTHLY_PRICE_ID=price_premium_monthly
# Optional. The annual toggle only appears when both annual prices exist.
STRIPE_CORE_ANNUAL_PRICE_ID=
STRIPE_PREMIUM_ANNUAL_PRICE_ID=
NEXT_PUBLIC_SITE_URL=https://www.opryn.app

# Branded team invitation email. Both values are server-only.
# Verify opryn.app with Resend, then use a sender on that domain.
RESEND_API_KEY=re_your-resend-api-key
OPRYN_INVITE_FROM_EMAIL="Opryn <team@opryn.app>"

# Server-only HMAC secret used to hash external agent API keys.
# Generate with: openssl rand -hex 32
EXTERNAL_AGENT_KEY_PEPPER=
MCP_TOKEN_HASH_SECRET=

# Twilio Call Learning. Server-only. Generate the encryption key with:
# openssl rand -base64 32
TWILIO_CREDENTIALS_ENCRYPTION_KEY=
# Optional exact override used for Twilio signature validation.
TWILIO_RECORDING_WEBHOOK_URL=https://www.opryn.app/api/webhooks/twilio/recording
# Protects the retry/retention maintenance endpoint.
CRON_SECRET=

# Opryn Everywhere. All values are server-only.
# Generate the encryption key with: openssl rand -base64 32
COMMUNICATION_CREDENTIALS_ENCRYPTION_KEY=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
# Must exactly match the Redirect URL configured in the Slack app.
SLACK_REDIRECT_URI=https://www.opryn.app/api/integrations/slack/callback

# Register a multi-tenant Microsoft Entra app and Teams bot using these credentials.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=https://www.opryn.app/api/integrations/teams/callback

# Encrypts customer-supplied third-party connection credentials server-side.
# Generate 32 random bytes and store them as 64 hexadecimal characters.
INTEGRATION_CREDENTIALS_ENCRYPTION_KEY=
# Nango: server-only, separate DEV and PROD environments. See docs/nango-integrations.md.
NANGO_SECRET_KEY=
NANGO_WEBHOOK_SECRET=
NANGO_ENVIRONMENT=DEV
NANGO_GOOGLE_DRIVE_INTEGRATION_ID=
GOOGLE_PICKER_API_KEY=
GOOGLE_PICKER_APP_ID=
# Optional override; must equal one of the configured Opryn Stripe Price IDs.
# Default trial preserves Premium monthly. All new trials last exactly 5 days.
STRIPE_TRIAL_PRICE_ID=
# true = collect payment method and convert after trial; false = cancel at end
# without a payment method. Never grants access independently of Stripe.
TRIAL_REQUIRES_PAYMENT_METHOD=true
